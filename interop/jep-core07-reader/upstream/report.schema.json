{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JEP BYOI scoped interoperability report, format 1",
  "type": "object",
  "required": [
    "report_format",
    "implementation",
    "generated_at",
    "jep_core",
    "wire_major",
    "conformance_draft",
    "signature_class",
    "requested_roles",
    "profiles",
    "conformance_suite",
    "outcome",
    "tests_passed",
    "tests_failed",
    "tests_unsupported",
    "tests_not_selected",
    "certification",
    "complete_core_coverage",
    "coverage",
    "limitations",
    "results"
  ],
  "properties": {
    "report_format": {
      "const": "jep-byoi-report/1"
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version",
        "source",
        "revision",
        "independence",
        "reused_components"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "independence": {
          "type": "string",
          "minLength": 1
        },
        "reused_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "jep_core": {
      "const": "0.7"
    },
    "wire_major": {
      "const": "1"
    },
    "conformance_draft": {
      "const": "draft-wang-jep-conformance-02"
    },
    "signature_class": {
      "type": "string"
    },
    "requested_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "producer",
          "verifier",
          "acceptance"
        ]
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conformance_suite": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "tests_passed": {
      "type": "integer",
      "minimum": 0
    },
    "tests_failed": {
      "type": "integer",
      "minimum": 0
    },
    "tests_unsupported": {
      "type": "integer",
      "minimum": 0
    },
    "tests_not_selected": {
      "type": "integer",
      "minimum": 0
    },
    "certification": {
      "const": false
    },
    "complete_core_coverage": {
      "const": false
    },
    "coverage": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "requirements",
          "outcome",
          "observations",
          "problems"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "document",
                "section"
              ]
            }
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "unsupported"
            ]
          },
          "observations": {
            "type": "array"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
